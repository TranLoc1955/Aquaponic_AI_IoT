   ],
   "text": "Nhiệt độ = Thấp VÀ Độ ẩm = Cao VÀ Ánh sáng = Vừa"
  },
  {
   "id": "L_denled_2",
   "target": "denled",
   "if": [
    {
     "sensor": "nhiet_do",
     "not": [
      "high"
     ]
    },
    {
     "sensor": "anh_sang",
     "is": "low"
    }
   ],
   "text": "Nhiệt độ ≠ Cao VÀ Ánh sáng = Thấp"
  },
  {
   "id": "L_maybom_1",
   "target": "maybom",
   "if": [
    {
     "sensor": "nhiet_do",
     "is": "high"
    },
    {
     "sensor": "do_am",
     "is": "low"
    },
    {
     "sensor": "muc_nuoc",
     "is": "mid"
    }
   ],
   "text": "Nhiệt độ = Cao VÀ Độ ẩm = Thấp VÀ Mực nước = Vừa"
  },
  {
   "id": "L_maybom_2",
   "target": "maybom",
   "if": [
    {
     "sensor": "muc_nuoc",
     "is": "low"
    }
   ],
   "text": "Mực nước = Thấp"
  }
