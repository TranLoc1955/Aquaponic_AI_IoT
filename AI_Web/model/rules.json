 "fragments": {
  "nhiet_cao": {
   "vi": "Nhiệt cao: bật quạt",
   "kind": "don_le"
  },
  "do_am_cao": {
   "vi": "Độ ẩm cao: bật quạt thông gió",
   "kind": "don_le"
  },
  "thieu_sang": {
   "vi": "Thiếu sáng: bật đèn LED",
   "kind": "don_le"
  },
  "muc_nuoc_thap": {
   "vi": "Mực nước thấp: bật bơm",
   "kind": "don_le"
  },
  "nuoc_day": {
   "vi": "Nước đầy: không bơm",
   "kind": "don_le"
  },
  "loi_nhiet": {
   "vi": "Cảm biến nhiệt lỗi: bật quạt an toàn",
   "kind": "loi"
  },
  "loi_sang": {
   "vi": "Cảm biến sáng lỗi: tắt đèn",
   "kind": "loi"
  },
  "loi_do_am": {
   "vi": "Cảm biến độ ẩm lỗi: bỏ qua độ ẩm",
   "kind": "loi"
  },
  "loi_nuoc": {
   "vi": "Cảm biến nước lỗi: tắt bơm",
   "kind": "loi"
  },
  "nang_gat": {
   "vi": "Nắng gắt: bật quạt hạ nhiệt",
   "kind": "ket_hop"
  },
  "nong_kho": {
   "vi": "Nóng + khô: bật bơm tưới hạ nhiệt",
   "kind": "ket_hop"
  },
  "nong_toi": {
   "vi": "Nóng + tối: không bật đèn (tránh sinh nhiệt)",
   "kind": "ket_hop"
  },
  "mat_am": {
   "vi": "Mát + ẩm: bật đèn LED để ấm và khô",
   "kind": "ket_hop"
  }
 },
 "fragment_rules": [
  {
   "id": "T_nhiet_cao_1",
   "target": "nhiet_cao",
   "if": [
    {
     "sensor": "nhiet_do",
     "is": "high"
    }
   ],
   "text": "Nhiệt độ = Cao"
  },
  {
   "id": "T_do_am_cao_1",
   "target": "do_am_cao",
   "if": [
    {
     "sensor": "do_am",
     "is": "high"
    }
   ],
   "text": "Độ ẩm = Cao"
  },
  {
   "id": "T_thieu_sang_1",
   "target": "thieu_sang",
   "if": [
    {
     "sensor": "nhiet_do",
     "not": [
      "high"
     ]
    },
    {
     "sensor": "anh_sang",
     "is": "low"
    }
   ],
   "text": "Nhiệt độ ≠ Cao VÀ Ánh sáng = Thấp"
  },
  {
   "id": "T_muc_nuoc_thap_1",
   "target": "muc_nuoc_thap",
   "if": [
    {
     "sensor": "muc_nuoc",
     "is": "low"
    }
   ],
   "text": "Mực nước = Thấp"
  },
  {
   "id": "T_nuoc_day_1",
   "target": "nuoc_day",
   "if": [
    {
     "sensor": "muc_nuoc",
     "is": "high"
    }
   ],
   "text": "Mực nước = Cao"
  },
  {
   "id": "T_loi_nhiet_1",
   "target": "loi_nhiet",
   "if": [
    {
     "sensor": "nhiet_do",
     "is": "fault"
    }
   ],
   "text": "Nhiệt độ = Lỗi"
  },
  {
   "id": "T_loi_sang_1",
   "target": "loi_sang",
   "if": [
    {
     "sensor": "anh_sang",
     "is": "fault"
    }
   ],
   "text": "Ánh sáng = Lỗi"
  },
  {
   "id": "T_loi_do_am_1",
   "target": "loi_do_am",
   "if": [
    {
     "sensor": "do_am",
     "is": "fault"
    }
   ],
   "text": "Độ ẩm = Lỗi"
  },
  {
   "id": "T_loi_nuoc_1",
   "target": "loi_nuoc",
   "if": [
    {
     "sensor": "muc_nuoc",
     "is": "fault"
    }
   ],
   "text": "Mực nước = Lỗi"
  },
  {
   "id": "T_nang_gat_1",
   "target": "nang_gat",
   "if": [
    {
     "sensor": "nhiet_do",
     "is": "mid"
    },
    {
     "sensor": "anh_sang",
     "is": "high"
    }
   ],
   "text": "Nhiệt độ = Vừa VÀ Ánh sáng = Cao"
  },
  {
   "id": "T_nong_kho_1",
   "target": "nong_kho",
   "if": [
    {
     "sensor": "nhiet_do",
     "is": "high"
    },
    {
     "sensor": "do_am",
     "is": "low"
    },
    {
     "sensor": "muc_nuoc",
     "is": "mid"
    }
   ],
   "text": "Nhiệt độ = Cao VÀ Độ ẩm = Thấp VÀ Mực nước = Vừa"
  },
  {
   "id": "T_nong_toi_1",
   "target": "nong_toi",
   "if": [
    {
     "sensor": "nhiet_do",
     "is": "high"
    },
    {
     "sensor": "anh_sang",
     "is": "low"
    }
   ],
   "text": "Nhiệt độ = Cao VÀ Ánh sáng = Thấp"
  },
  {
   "id": "T_mat_am_1",
   "target": "mat_am",
   "if": [
    {
     "sensor": "nhiet_do",
     "is": "low"
    },
    {
     "sensor": "do_am",
     "is": "high"
    },
    {
     "sensor": "anh_sang",
     "is": "mid"
    }
   ],
   "text": "Nhiệt độ = Thấp VÀ Độ ẩm = Cao VÀ Ánh sáng = Vừa"
  }
 ],
 "device_rules": [
  {
